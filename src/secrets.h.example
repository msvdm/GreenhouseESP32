#pragma once

// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored - credentials must never be committed.

// These are the FACTORY values only. The access point credentials can be
// changed from the WiFi page once the board is running, and whatever you
// confirm there is stored in NVS and used from then on. These are what a
// brand-new board comes up on, and what "Factory reset WiFi" restores.
//
// ChangeME is exactly 8 characters, which is the WPA2 minimum. Change it.
#define AP_SSID     "Green"
#define AP_PASSWORD "ChangeME"

// Password for the WEB UI - the controls, the settings page and the browser
// firmware upload. Stored as a salted SHA-256 in NVS, never in plaintext, and
// the interface nags until it has been changed from this default.
//
// This is NOT the access point password above. That one is a link-layer secret
// shared with every device that joins the radio; this one should not be.
#define UI_PASSWORD "GreenAdmin"

// Password required to push firmware over the air with espota. Anyone who knows
// this can replace the firmware controlling a 2200W element - treat it
// accordingly. This one is NOT editable from the web page: it is compiled in,
// so losing access to the web UI can never lock you out of the recovery path.
//
// Never make this the same string as AP_PASSWORD. Sharing the WiFi password
// with a visitor would otherwise hand them the firmware-push credential too.
#define OTA_PASSWORD "change-me-too"
