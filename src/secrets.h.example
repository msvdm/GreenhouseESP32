#pragma once

// Copy this file to secrets.h (gitignored) and fill in your own values.

// Factory access point. Used on a fresh board and after an IO0 factory reset;
// otherwise the values saved from the Settings page are used.
#define AP_SSID     "Green"
#define AP_PASSWORD "ChangeME"    // 8-63 characters

// Factory web UI password. Stored as a salted SHA-256 in NVS; change it from
// the Settings page.
#define UI_PASSWORD "GreenAdmin"

// Password for PlatformIO OTA uploads (espota, `pio run -e ota -t upload`).
// Compiled in so a forgotten web password can never lock you out of updates.
#define OTA_PASSWORD "change-me"
